NODE_ENV=development
PORT=5173

# Security
CSRF_STRICT=false
MAX_BODY_BYTES=1048576
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_AGENT=12
RATE_LIMIT_IMPORT=8
ADMIN_EMAILS=

# Supabase persistence. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=comic30-exports

# Optional real LLM generation. Without this, Comic30 uses the local deterministic generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Transactional email provider placeholders.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@comic30.com
APP_BASE_URL=http://127.0.0.1:5173

# Store and wallet integrations.
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=
WALLET_CUSTODY_PROVIDER=
WALLET_COMPLIANCE_CONTACT=
