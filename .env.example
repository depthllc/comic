NODE_ENV=development
PORT=5173

# Security
CSRF_STRICT=false
MAX_BODY_BYTES=1048576
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_AGENT=12
RATE_LIMIT_IMPORT=8
ADMIN_EMAILS=

# Supabase persistence. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=comic30-exports
SUPABASE_ASSET_BUCKET=comic30-assets
# Direct local uploads and post-upload validation are capped per file. Production
# browser uploads go directly to the private asset bucket through signed URLs.
MAX_ASSET_UPLOAD_BYTES=262144000

# Optional real LLM generation. Without this, Comic30 uses the local deterministic generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# High-fidelity source-asset worker. This is a separate long-running service,
# not a Vercel route. The owned-first order is self-hosted TRELLIS.2, followed
# by an optional Meshy burst/failure fallback. Provider keys never reach the browser.
COMIC30_ASSET_GENERATOR_URL=http://127.0.0.1:5190
COMIC30_ASSET_WORKER_TOKEN=replace-with-a-long-random-shared-token
COMIC30_ASSET_WORKER_PORT=5190
COMIC30_ASSET_WORKER_HOST=127.0.0.1
COMIC30_ASSET_PROVIDER_ORDER=trellis2,meshy
COMIC30_ASSET_WORKER_DATA_DIR=./worker-data/source-assets
COMIC30_PROVIDER_REQUEST_TIMEOUT_MS=60000
COMIC30_ASSET_POLL_MS=5000
COMIC30_ASSET_MAX_WAIT_MS=1800000
COMIC30_MAX_ARTIFACT_BYTES=524288000
# TRELLIS.2 is image-conditioned. Its service may expose a prompt-to-image front
# end and advertise promptOnly=true, otherwise Comic30 supplies an image reference.
COMIC30_TRELLIS2_URL=
COMIC30_TRELLIS2_TOKEN=
COMIC30_TRELLIS2_TEXTURE_RESOLUTION=2048
# Optional commercial fallback only.
MESHY_API_KEY=
MESHY_MODEL=latest
MESHY_TEXTURE_RESOLUTION=4k
MESHY_TARGET_POLYCOUNT=100000

# Persisted rig worker. It downloads only validated source artifacts from the
# source worker, stores its own evidence, and never exposes provider keys to the browser.
COMIC30_RIG_WORKER_URL=http://127.0.0.1:5191
COMIC30_RIG_WORKER_TOKEN=replace-with-a-different-long-random-shared-token
COMIC30_RIG_WORKER_PORT=5191
COMIC30_RIG_WORKER_HOST=127.0.0.1
COMIC30_RIG_PROVIDER_ORDER=unirig,meshy
COMIC30_RIG_WORKER_DATA_DIR=./worker-data/rigs
COMIC30_RIG_ALLOWED_SOURCE_ORIGINS=http://127.0.0.1:5190,http://localhost:5190
COMIC30_SOURCE_ASSET_WORKER_TOKEN=replace-with-a-long-random-shared-token
COMIC30_RIG_HEALTH_TIMEOUT_MS=3000
COMIC30_RIG_SUBMIT_TIMEOUT_MS=15000
COMIC30_RIG_STATUS_TIMEOUT_MS=8000
COMIC30_RIG_POLL_MS=5000
COMIC30_RIG_MAX_WAIT_MS=1800000
# UniRig owns humanoid and creature skeleton/skin inference. The three optional
# argument fields make profile-specific UniRig checkpoints/configuration possible.
COMIC30_UNIRIG_ROOT=
COMIC30_UNIRIG_BASH=bash
COMIC30_UNIRIG_SKELETON_ARGS=
COMIC30_UNIRIG_HUMANOID_SKIN_ARGS=
COMIC30_UNIRIG_CREATURE_SKIN_ARGS=
COMIC30_UNIRIG_SKIN_ARGS=
COMIC30_UNIRIG_MERGE_ARGS=
# Vehicle articulation requires authored chassis/wheel nodes or Blender.
COMIC30_BLENDER_EXECUTABLE=

# Unreal runs downstream of validated source/rig artifacts on a Windows GPU worker.
COMIC30_UNREAL_ROOT=C:\Program Files\Epic Games\UE_5.6

# Persisted animation worker. It consumes only checksum-verified rig outputs,
# validates semantic retarget chains, generated keyframes and deformation, and
# emits a separate Unreal animation handoff. MotionGPT is an optional owned
# humanoid provider; Blender supplies local vehicle articulation.
COMIC30_ANIMATION_WORKER_URL=http://127.0.0.1:5192
COMIC30_ANIMATION_WORKER_TOKEN=replace-with-a-third-long-random-shared-token
COMIC30_ANIMATION_WORKER_PORT=5192
COMIC30_ANIMATION_WORKER_HOST=127.0.0.1
COMIC30_ANIMATION_WORKER_DATA_DIR=./worker-data/animations
COMIC30_ANIMATION_ALLOWED_RIG_ORIGINS=http://127.0.0.1:5191,http://localhost:5191
COMIC30_ANIMATION_HEALTH_TIMEOUT_MS=3000
COMIC30_ANIMATION_SUBMIT_TIMEOUT_MS=15000
COMIC30_ANIMATION_STATUS_TIMEOUT_MS=8000
COMIC30_ANIMATION_REQUEST_TIMEOUT_MS=60000
COMIC30_ANIMATION_MAX_ARTIFACT_BYTES=524288000
COMIC30_MOTIONGPT_URL=
COMIC30_MOTIONGPT_TOKEN=
COMIC30_MOTIONGPT_POLL_MS=3000
COMIC30_MOTIONGPT_MAX_WAIT_MS=1200000

# Persisted audio generation and acoustic-QA worker. Keep the shared token identical
# on the portal and worker; never expose the provider token to browser code.
COMIC30_AUDIO_WORKER_URL=http://127.0.0.1:5193
COMIC30_AUDIO_WORKER_TOKEN=replace-with-a-fourth-long-random-secret
COMIC30_AUDIO_WORKER_PORT=5193
COMIC30_AUDIO_WORKER_HOST=127.0.0.1
COMIC30_AUDIO_WORKER_DATA_DIR=./worker-data/audio
COMIC30_AUDIO_MAX_ARTIFACT_BYTES=262144000
COMIC30_AUDIO_HEALTH_TIMEOUT_MS=3000
COMIC30_AUDIO_SUBMIT_TIMEOUT_MS=15000
COMIC30_AUDIO_STATUS_TIMEOUT_MS=8000
COMIC30_AUDIO_POLL_MS=5000
COMIC30_AUDIO_MAX_WAIT_MS=1800000

# Owned AudioCraft-compatible inference service. The audio worker calls this URL;
# do not put its token on Vercel or in public frontend variables.
COMIC30_AUDIOCRAFT_URL=
COMIC30_AUDIOCRAFT_TOKEN=
COMIC30_AUDIOCRAFT_POLL_MS=3000
COMIC30_AUDIOCRAFT_MAX_WAIT_MS=1200000
COMIC30_AUDIOCRAFT_REQUEST_TIMEOUT_MS=60000

# Transactional email provider placeholders.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@comic30.com
APP_BASE_URL=http://127.0.0.1:5173

# Store and wallet integrations.
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=
WALLET_CUSTODY_PROVIDER=
WALLET_COMPLIANCE_CONTACT=
